# ============================================
# Hyper-Connect MVP 환경 변수 템플릿
# Version: 2.0
# Last Updated: 2026-01-19
#
# 사용법:
# 1. 이 파일을 복사하여 .env.local (Frontend) 또는 .env (Backend) 생성
# 2. 각 값을 실제 환경에 맞게 수정
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=Hyper-Connect
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/hyper_connect_dev

# Redis (선택 - 캐싱용)
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION
# ============================================
# JWT 비밀 키 (32자 이상 랜덤 문자열 권장)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth (Frontend)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production

# ============================================
# AWS CONFIGURATION
# ============================================
# AWS 자격 증명
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-2

# S3 버킷
AWS_S3_BUCKET=hyper-connect-media-dev
AWS_S3_REGION=ap-northeast-2

# CloudFront (CDN)
AWS_CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net
AWS_CLOUDFRONT_KEY_PAIR_ID=your-key-pair-id
# CloudFront 서명 키 (PEM 형식, Base64 인코딩)
AWS_CLOUDFRONT_PRIVATE_KEY=your-private-key-base64

# ============================================
# EXTERNAL APIS
# ============================================
# 환율 API (ExchangeRate-API)
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6

# Firebase (푸시 알림용 - P2)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ============================================
# EMAIL (선택)
# ============================================
# SMTP 설정 (비밀번호 재설정 등)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Hyper-Connect <noreply@hyper-connect.com>"

# ============================================
# SECURITY
# ============================================
# CORS 허용 도메인 (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# 암호화 키 (VIN 등 민감 정보 암호화용)
ENCRYPTION_KEY=your-32-character-encryption-key!!

# ============================================
# LOGGING & MONITORING
# ============================================
# 로그 레벨 (debug, info, warn, error)
LOG_LEVEL=debug

# Sentry (에러 트래킹)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Prisma 디버그 로깅
DEBUG=prisma:query

# 테스트 계정 (개발용)
TEST_ADMIN_EMAIL=admin@hyper-connect.com
TEST_ADMIN_PASSWORD=admin123!
TEST_SELLER_EMAIL=seller@hyper-connect.com
TEST_SELLER_PASSWORD=seller123!
